# ── OS / editor ───────────────────────────────────────────
.DS_Store
Thumbs.db
*.sw?
.idea/
.vscode/*
!.vscode/extensions.json
*.sublime-*

# ── Logs / temp ───────────────────────────────────────────
*.log
*.tmp
npm-debug.log*
yarn-debug.log*

# ── Frontend ──────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local
frontend/vite.log

# ── Backend (Laravel) ─────────────────────────────────────
backend/vendor/
backend/node_modules/
backend/public/build/
backend/public/hot
backend/public/storage
backend/storage/*.key
backend/storage/logs/*
backend/storage/app/*
backend/storage/framework/cache/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*
backend/storage/framework/testing/*
backend/.env
backend/.env.backup
backend/.env.production
backend/.phpunit.result.cache
backend/database/database.sqlite

# keep framework dirs' structure
!backend/storage/app/.gitignore
!backend/storage/framework/cache/.gitignore
!backend/storage/framework/sessions/.gitignore
!backend/storage/framework/views/.gitignore
!backend/public/storage/.gitignore
